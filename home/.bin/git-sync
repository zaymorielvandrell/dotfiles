#!/bin/bash

set -euo pipefail

log_info() {
  printf '%s\n' "$*"
}

log_error() {
  printf 'ERROR: %s\n' "$*" >&2
}

main() {
  local branch
  local timestamp
  local message
  local reply

  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log_error 'not inside a git repository'
    exit 1
  fi

  branch="$(git branch --show-current)"

  if [[ -z "$(git status --porcelain)" ]]; then
    log_info "INFO: nothing to commit on ${branch}"
    exit 0
  fi

  git add .

  timestamp="$(date +%Y%m%d-%H%M)"

  if (($# > 0)); then
    message="$*"
  else
    message="chore(dev): sync ${timestamp}"
  fi

  git commit -m "${message}"

  read -rp "Push to ${branch}? [Y/n]: " reply

  if [[ ! "${reply:-Y}" =~ ^[Yy]$ ]]; then
    log_info 'Operation cancelled'
    exit 0
  fi

  git push
  log_info "Pushed to ${branch} with message: ${message}"
}

main "$@"
