#!/bin/bash

set -euo pipefail

SEARCH_DIRS=(
  "$HOME"
  "${HOME}/Workspace/Personal"
  "${HOME}/Workspace/Research"
  "${HOME}/Workspace/Work"
)

log_error() {
  printf "ERROR: %s\n" "$*" >&2
}

switch_to_session() {
  local session_name="$1"

  if [[ -z "${TMUX:-}" ]]; then
    tmux attach-session -t "$session_name"
  else
    tmux switch-client -t "$session_name"
  fi
}

main() {
  local selected
  local session_name

  if (($# == 1)); then
    selected="$1"
  elif (($# == 0)); then
    selected="$(find "${SEARCH_DIRS[@]}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | fzf || true)"
  else
    log_error "usage: $(basename "$0") [directory]"
    exit 2
  fi

  if [[ -z "$selected" ]]; then
    exit 0
  fi

  session_name="$(basename "$selected" | tr "." "_")"

  if [[ -z "${TMUX:-}" ]] && ! pgrep tmux >/dev/null; then
    tmux new-session -s "$session_name" -c "$selected"
    exit 0
  fi

  if ! tmux has-session -t "$session_name" 2>/dev/null; then
    tmux new-session -ds "$session_name" -c "$selected"
  fi

  switch_to_session "$session_name"
}

main "$@"
